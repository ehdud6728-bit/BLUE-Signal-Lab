      - name: Setup Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install pinned data libraries
        run: |
          python -m pip install --disable-pip-version-check \
            'pandas==2.3.3' 'numpy==2.3.5' 'pyarrow==22.0.0' 'requests==2.32.5'

      - name: Verify chronological fills no-lookahead and profit-lock rules
        run: |
          python -B -m unittest discover -s "$RUNNER_TEMP/r15127" -p test_study.py -v

      - name: Recompute full market and compare 1966080 hypothetical exit paths
        run: |
          python -B "$RUNNER_TEMP/r15127/study.py" \
            --input "$RUNNER_TEMP/r15127" \
            --output output/r15127_profit_exit

      - name: Check frozen baseline strict sample and DBH case outputs
        run: |
          python - <<'PY'
          import json, pandas as pd
          from pathlib import Path
          out=Path('output/r15127_profit_exit')
          names=('EXIT_GRID_SUMMARY.csv', 'ALL8_COMMON_PAIRED_SUMMARY.csv',
                 'TOP20_DISCOVERY_ONLY_WITH_LATER_YEARS.csv',
                 'SIGNAL_DAY_AND_HINDSIGHT.csv',
                 'EXCLUDED_NONPROTECTIVE_STOPS.csv',
                 'DBH_2026_05_21_EXIT_GRID.csv',
                 'EXIT_GRID_EXECUTIONS.csv.gz', 'AUDIT.json', 'README_KO.md')
          if any(not (out/f).is_file() or (out/f).stat().st_size < 100 for f in names):
              raise SystemExit('R15127_MISSING_OR_EMPTY_OUTPUT')
          a=json.loads((out/'AUDIT.json').read_text(encoding='utf-8'))
          if not (a['version'].startswith('R15127_') and a['read_only']
                  and a['no_d1_write'] and a['no_deploy']
                  and a['no_live_or_search_modification']
                  and a['r15121_population_identical']
                  and a['raw_nonoverlap_core_events']==4130
                  and a['immature_10d_events_excluded']==25
                  and a['initial_core_events']==4105
                  and a['strict_common_valid_events']==4096
                  and a['excluded_nonprotective_events']==9
                  and a['event_scenario_rows']==1966080
                  and abs(a['dbh_anchor']['signal_peak_high_pct']-28.9149888143)<.02
                  and abs(a['dbh_anchor']['signal_final_pct']+11.1856823266)<.02):
              raise SystemExit('R15127_BASELINE_OR_PAIRING_AUDIT_FAILED')
          d=pd.read_csv(out/'DBH_2026_05_21_EXIT_GRID.csv')
          if len(d)!=480 or d.stop_mode.nunique()!=8:
              raise SystemExit('R15127_DBH_GRID_INCOMPLETE')
          print('R15127_8_STOPS_10_TARGETS_3_HORIZONS_2_LOCKS_VERIFIED')
          PY

      - name: Upload isolated research results for 30 days
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: BLUE_R15127_PROFIT_EXIT_${{ github.run_id }}
          path: output/r15127_profit_exit/
          if-no-files-found: error
          retention-days: 30
